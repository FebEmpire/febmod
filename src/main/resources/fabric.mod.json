{
  "schemaVersion": 1,
  "id": "febmod",
  "version": "${version}",
  "name": "febmod",
  "description": "FebMod is an addons based mod",
  "authors": [
    "Februari10"
  ],
  "contributors": [
    "Oblongboot"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/febmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "com.feb.mod.Febmod",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "com.feb.mod.FebmodDataGenerator",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "febmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}